---
const primaryLinks = [
  {
    label: 'Watch my videos',
    href: 'https://www.youtube.com/channel/UCmPfConh9Piq8UpK_sW83jA/',
    className: 'primary',
  },
  {
    label: 'Try Planomy',
    href: 'https://planomy.com',
    className: 'secondary',
  },
  {
    label: 'Explore my GitHub',
    href: 'https://github.com/giorgiotoffoli',
    className: 'tertiary',
  },
]

const secondaryLinks = [
  {
    label: 'Instagram',
    href: 'https://instagram.com/giorgio.toffoli',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/giorgiotoffoli',
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Giorgio Toffoli</title>

    <meta
      name="description"
      content="Giorgio Toffoli — software, videos, and things I'm building."
    />
  </head>

  <body>
    <main>
      <div class="content">
        <h1 class="blur-fade" style="--delay: 0ms;">Giorgio Toffoli</h1>

        <nav class="destinations" aria-label="Main links">
          {
            primaryLinks.map((link, index) => (
              <a
                href={link.href}
                class={`destination destination--${link.className} blur-fade`}
                style={`--delay: ${120 + index * 90}ms;`}
                target="_blank"
              >
                <span class="destination-title">{link.label}</span>

                <span class="arrow">↗</span>
              </a>
            ))
          }
        </nav>

        <nav class="socials" aria-label="Social links">
          {
            secondaryLinks.map((link, index) => (
              <a
                href={link.href}
                class="blur-fade"
                style={`--delay: ${410 + index * 80}ms;`}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;

    background: #000;
    color: #f5f5f5;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    background: #000;
    -webkit-font-smoothing: antialiased;
  }

  main {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 32px;
  }

  .content {
    width: min(100%, 540px);
  }

  h1 {
    margin: 0 0 56px;

    font-size: clamp(3.25rem, 7vw, 5.7rem);
    font-weight: 500;

    line-height: 0.93;
    letter-spacing: -0.06em;
  }

  .destinations {
    display: flex;
    flex-direction: column;
  }

  .destination {
    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid #202020;

    color: inherit;
    text-decoration: none;

    transition:
      color 180ms ease,
      border-color 180ms ease,
      padding-left 180ms ease;
  }

  .destination-title {
    display: block;
    letter-spacing: -0.025em;
  }

  .destination--primary {
    padding: 26px 0;
  }

  .destination--primary .destination-title {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .destination--secondary {
    padding: 23px 0;
  }

  .destination--secondary .destination-title {
    font-size: 1.22rem;
    font-weight: 500;
  }

  .destination--tertiary {
    padding: 19px 0;
    color: #818181;
  }

  .destination--tertiary .destination-title {
    font-size: 1rem;
    font-weight: 400;
  }

  .destination:hover {
    color: #fff;
    border-color: #333;

    padding-left: 6px;
  }

  .arrow {
    color: #555;
    font-size: 1rem;

    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .destination:hover .arrow {
    color: #fff;
    transform: translate(2px, -2px);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;

    margin-top: 32px;
  }

  .socials a {
    color: #666;

    font-size: 0.84rem;
    text-decoration: none;

    transition: color 180ms ease;
  }

  .socials a:hover {
    color: #fff;
  }

  /* Blur entrance */

  .blur-fade {
    opacity: 0;
    filter: blur(7px);
    transform: translateY(10px);

    animation: blurFade 650ms cubic-bezier(0.22, 1, 0.36, 1) forwards;

    animation-delay: var(--delay);
  }

  @keyframes blurFade {
    from {
      opacity: 0;
      filter: blur(7px);
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  @media (max-width: 600px) {
    main {
      align-items: flex-start;

      padding: 25vh 24px 64px;
    }

    h1 {
      margin-bottom: 42px;
    }

    .destination--primary .destination-title {
      font-size: 1.35rem;
    }

    .socials {
      gap: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blur-fade {
      opacity: 1;
      filter: none;
      transform: none;
      animation: none;
    }
  }
</style>
